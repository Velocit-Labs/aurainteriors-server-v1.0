# Server Configuration
PORT=3001
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/aura_interiors_db

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Frontend URL (CORS/Redirects)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Email Service (Brevo)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM="Your Company <noreply@yourdomain.com>"

# Admin Credentials (For Seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# Firebase Push Notifications
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key_here"

# Redis
REDIS_PORT=6379

# Backend URL (For Callbacks and Keep-Alive Service)
# For Render: https://your-service-name.onrender.com
# For local development: http://localhost:3001
BACKEND_URL=http://localhost:3001

# Payment Gateway (eSewa)
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# LLM and Embedding API Keys
NVIDIA_API_KEY=your_nvidia_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
EMBEDDING_MODEL_NAME=nvidia/llama-nemotron-embed-1b-v2

# Keep-Alive Service Configuration (Prevents Render idle shutdown)
# Set to 'true' to enable keep-alive pinging (auto-enabled in production)
KEEP_ALIVE_ENABLED=true

# Keep-Alive interval in minutes (default: 14 minutes for Render free tier)
# Render free tier has a 15-minute idle timeout, so 14 minutes is safe
# Premium tier has a 30-minute timeout, so 25 minutes would be safe
KEEP_ALIVE_INTERVAL=14
